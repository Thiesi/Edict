#!/usr/bin/env php
<?php

declare(strict_types=1);

use Edict\Cli\AdminCreateCommand;
use Edict\Cli\AdminResetCommand;
use Edict\Cli\AdminRevokeSessionsCommand;
use Edict\Cli\MigrateCommand;
use Edict\Kernel;
use Edict\Services;
use Symfony\Component\Console\Application;

require dirname(__DIR__) . '/vendor/autoload.php';

$services = new Services(Kernel::boot(dirname(__DIR__))->getContainer());

$console = new Application('Edict');
$console->addCommands([
    $services->get(MigrateCommand::class),
    $services->get(AdminCreateCommand::class),
    $services->get(AdminResetCommand::class),
    $services->get(AdminRevokeSessionsCommand::class),
]);
exit($console->run());
