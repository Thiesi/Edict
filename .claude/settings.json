{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/scratch_hook.py\" start 2>/dev/null || true",
            "timeout": 120,
            "statusMessage": "Checking worktree scratch"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/scratch_hook.py\" end 2>/dev/null || true",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
