{% extends 'public/layout.html.twig' %}

{% set meta = {url: '/'} %}

{% block structured_data %}{{ structured_data_website() }}{% endblock %}

{% block title %}{{ site().title }}{% endblock %}

{% block main %}
    <main>
        <h1 class="home-heading">Latest</h1>
        {% include 'public/_lang_filter.html.twig' %}
        {% if articles %}
            <ul class="articles">
                {% for article in articles %}{% include 'public/_summary.html.twig' %}{% endfor %}
            </ul>
            {% if has_more %}<p class="more"><a class="button" href="/archive{{ lang_filter ? '?lang=' ~ lang_filter : '' }}">All articles</a></p>{% endif %}
        {% else %}
            <p class="empty">A CMS for one sovereign. Nothing to read yet.</p>
            {% if is_admin|default(false) and nothing_yet|default(false) %}
                <form class="first-article" method="post" action="/admin/articles">
                    <input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">
                    <input type="hidden" name="kind" value="article">
                    <button class="button-primary" type="submit">Write the first article</button>
                </form>
            {% endif %}
        {% endif %}
    </main>
{% endblock %}
