{% extends 'public/layout.html.twig' %}

{# Shared: a private preview link (#85), for someone without an account. It names no
   address: a draft's may be a placeholder, and the link's own must stay private. #}
{% set shared_preview = shared_preview|default(false) %}
{% set meta = {
    title: article.title,
    description: article.teaser ?: null,
    url: shared_preview ? null : '/' ~ article.slug,
    type: article.kind == 'article' ? 'article' : 'website',
    locale: article.lang == 'de' ? 'de_DE' : 'en_GB',
    image: preview ? null : share_image(article),
    image_alt: article.coverAlt,
    robots: shared_preview ? 'noindex, nofollow' : (preview ? 'noindex' : null),
}|filter(v => v is not null) %}

{# The same share image as og:image. #}
{% block structured_data %}{{ structured_data_article(article) }}{% endblock %}

{% block title %}{{ article.title }} · {{ site().title }}{% endblock %}

{% block main %}
    {% if shared_preview %}
        <p class="notice preview-banner" role="status"><strong>Preview, not published.</strong> This text may still change before it goes live.</p>
    {% elseif preview %}
        <p class="notice" role="status"><strong>Preview.</strong> Status: {% if article.scheduled %}scheduled for {{ article.publishedAt|admin_datetime }} (Berlin time){% else %}{{ article.status }}{% endif %}. <a href="/admin/articles/{{ article.id }}">Back to the editor</a></p>
    {% endif %}
    <main>
        <article lang="{{ article.lang }}">
            <h1>{{ article.title }}</h1>
            {% if article.kind == 'article' and article.publishedAt %}
                <p class="article-meta">
                    <time datetime="{{ article.publishedAt|article_iso }}">{{ article.publishedAt|article_date(article.lang) }}</time>
                    · <span class="reading-time">{{ article.readingTime }}</span>
                    {% if article.revisedAt and article.revisedAt - article.publishedAt > 86400 %}
                        · <span class="updated">{{ article.lang == 'de' ? 'Aktualisiert am' : 'Updated on' }} <time datetime="{{ article.revisedAt|article_iso }}">{{ article.revisedAt|article_date(article.lang) }}</time></span>
                    {% endif %}
                </p>
            {% endif %}
            {{ article_cover(article) }}
            {% if article.teaser %}<p class="teaser">{{ article.teaser }}</p>{% endif %}
            {{ article.bodyJson|body_html }}
        </article>
        {% if article.kind == 'article' and article.tags %}
            <p class="tags"><span class="tags-label">Tags:</span>
                {% for tag in article.tags %}<a href="/tag/{{ tag.slug }}">{{ tag.name }}</a>{% if not loop.last %}<span class="visually-hidden">, </span>{% endif %}{% endfor %}
            </p>
        {% endif %}
        {% if likes is defined and likes %}{% include 'public/_likes.html.twig' %}{% endif %}
        {% if neighbours is defined %}{% include 'public/_neighbours.html.twig' %}{% endif %}
        {% if related is defined and related %}{% include 'public/_related.html.twig' %}{% endif %}
        {% if comments is defined and comments %}{% include 'public/_comments.html.twig' %}{% endif %}
    </main>
    <script src="/assets/lightbox.js" defer></script>
    <script src="/assets/player.js" defer></script>
    {% if likes is defined and likes and session and not banned %}<script src="/assets/likes.js" defer></script>{% endif %}
{% endblock %}
