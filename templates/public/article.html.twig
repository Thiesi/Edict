{% extends 'public/layout.html.twig' %}

{% block title %}{{ article.title }} · {{ site().title }}{% endblock %}

{% block main %}
    {% if preview %}
        <p role="status"><strong>Preview.</strong> Status: {{ article.status }}. <a href="/admin/articles/{{ article.id }}">Back to the editor</a></p>
    {% endif %}
    <main>
        <article lang="{{ article.lang }}">
            <h1>{{ article.title }}</h1>
            {% if article.kind == 'article' and article.publishedAt %}
                <p>
                    <time datetime="{{ article.publishedAt|article_iso }}">{{ article.publishedAt|article_date(article.lang) }}</time>
                    {% if article.revisedAt and article.revisedAt - article.publishedAt > 86400 %}
                        · <span class="updated">{{ article.lang == 'de' ? 'Aktualisiert am' : 'Updated on' }} <time datetime="{{ article.revisedAt|article_iso }}">{{ article.revisedAt|article_date(article.lang) }}</time></span>
                    {% endif %}
                </p>
            {% endif %}
            {{ article_cover(article) }}
            {% if article.teaser %}<p class="teaser">{{ article.teaser }}</p>{% endif %}
            {{ article.bodyJson|body_html }}
        </article>
        {% if likes is defined and likes %}{% include 'public/_likes.html.twig' %}{% endif %}
        {% if comments is defined and comments %}{% include 'public/_comments.html.twig' %}{% endif %}
        {% if article.kind == 'article' and article.tags %}
            <p>Tags:
                {% for tag in article.tags %}<a href="/tag/{{ tag.slug }}">{{ tag.name }}</a>{% if not loop.last %}, {% endif %}{% endfor %}
            </p>
        {% endif %}
    </main>
    <script src="/assets/lightbox.js" defer></script>
    <script src="/assets/player.js" defer></script>
    {% if likes is defined and likes and session and not banned %}<script src="/assets/likes.js" defer></script>{% endif %}
{% endblock %}
