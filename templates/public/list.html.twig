{% extends 'public/layout.html.twig' %}

{% set meta = {url: base_path ~ (page > 1 ? '?page=' ~ page : '')} + (feed is defined ? {feed: feed} : {}) %}

{% block title %}{{ heading }} · {{ site().title }}{% endblock %}

{% block main %}
    <main>
        <h1>{{ heading }}</h1>
        {% if lang_filter is defined %}{% include 'public/_lang_filter.html.twig' %}{% endif %}
        {% if articles %}
            <ul class="articles">
                {% for article in articles %}{% include 'public/_summary.html.twig' %}{% endfor %}
            </ul>
        {% else %}
            <p>Nothing to read yet.</p>
        {% endif %}
        {% if last_page > 1 %}
            <nav aria-label="Pages">
                {% set keep = lang_filter|default(null) ? 'lang=' ~ lang_filter ~ '&' : '' %}
                {% if page > 1 %}<a rel="prev" href="{{ base_path }}{% if page > 2 or keep %}?{{ keep }}{% if page > 2 %}page={{ page - 1 }}{% endif %}{% endif %}">Newer</a>{% endif %}
                Page {{ page }} of {{ last_page }}
                {% if page < last_page %}<a rel="next" href="{{ base_path }}?{{ keep }}page={{ page + 1 }}">Older</a>{% endif %}
            </nav>
        {% endif %}
    </main>
{% endblock %}
