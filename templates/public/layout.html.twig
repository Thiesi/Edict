{% extends 'base.html.twig' %}

{% set site = site() %}
{% set look = site_look() %}

{% block head %}
    {% set meta = meta|default({}) %}
    {% set description = meta.description|default(site.description) %}
    {% if description %}<meta name="description" content="{{ description }}">{% endif %}
    {% if meta.robots is defined %}<meta name="robots" content="{{ meta.robots }}">{% endif %}
    {% if meta.url is defined %}
        <link rel="canonical" href="{{ app_url ~ meta.url }}">
        <meta property="og:url" content="{{ app_url ~ meta.url }}">
    {% endif %}
    <meta property="og:site_name" content="{{ site.title }}">
    <meta property="og:type" content="{{ meta.type|default('website') }}">
    <meta property="og:title" content="{{ meta.title|default(site.title) }}">
    {% if description %}<meta property="og:description" content="{{ description }}">{% endif %}
    {% if meta.locale is defined %}<meta property="og:locale" content="{{ meta.locale }}">{% endif %}
    {% if meta.image is defined and meta.image %}
        <meta property="og:image" content="{{ meta.image.url }}">
        <meta property="og:image:width" content="{{ meta.image.width }}">
        <meta property="og:image:height" content="{{ meta.image.height }}">
        {% if meta.image_alt is defined and meta.image_alt %}<meta property="og:image:alt" content="{{ meta.image_alt }}">{% endif %}
        <meta name="twitter:card" content="summary_large_image">
    {% else %}
        <meta name="twitter:card" content="summary">
    {% endif %}
    {# Structured data, for the pages that describe something: the home page and published
        articles and pages. Any preview (the admin's, or a preview link) sets `preview` and gets none. #}
    {% if not preview|default(false) %}{% block structured_data %}{% endblock %}{% endif %}
    <link rel="alternate" type="application/atom+xml" title="{{ site.title }}" href="/feed.atom">
    {% if meta.feed is defined %}<link rel="alternate" type="application/atom+xml" title="{{ meta.feed.title }}" href="{{ meta.feed.url }}">{% endif %}
    <link rel="stylesheet" href="/assets/site.css?v={{ asset_version }}">
    <link rel="stylesheet" href="/assets/build/themes/{{ site.theme }}.css?v={{ asset_version }}">
    {% if look.accentVersion %}<link rel="stylesheet" href="/accent.css?theme={{ site.theme }}&amp;v={{ look.accentVersion }}">{% endif %}
{% endblock %}

{% block icons %}
    {% set icons = look.icons %}
    {% if icons %}
        <link rel="icon" href="{{ icons[32] }}" sizes="32x32" type="image/png">
        <link rel="icon" href="{{ icons[192] }}" sizes="192x192" type="image/png">
        <link rel="apple-touch-icon" href="{{ icons[180] }}">
    {% else %}
        {{ parent() }}
    {% endif %}
{% endblock %}

{% block body_class %}theme-{{ site.theme }}{% endblock %}

{% block body %}
    <a class="skip-link" href="#content">Skip to the content</a>
    <header class="site-header">
        <div class="site-header-inner">
            {% set logo = look.logo %}
            <p class="site-title{% if logo %} has-logo{% endif %}"><a href="/">
                {%- if logo %}<img class="site-logo" src="{{ logo.src }}"{% if logo.srcset %} srcset="{{ logo.srcset }}" sizes="12rem"{% endif %} width="{{ logo.width }}" height="{{ logo.height }}" alt="{{ site.logoOnly ? site.title : '' }}">{% endif -%}
                {%- if not logo %}{{ site.title }}{% elseif not site.logoOnly %}<span class="site-name">{{ site.title }}</span>{% endif -%}
            </a></p>
            {% if site.description %}<p class="site-description">{{ site.description }}</p>{% endif %}
            <div class="site-header-bar">
                <nav class="site-nav" aria-label="Main">
                    <ul>
                        {% for link in site.menu %}<li><a href="{{ link.url }}">{{ link.label }}</a></li>{% endfor %}
                        <li><a href="/archive">Archive</a></li>
                        {% if is_admin|default(false) %}
                            <li><a href="/admin">Admin</a></li>
                            {# Forms, not links: starting a piece creates its row. #}
                            {% for kind, label in {article: 'New article', page: 'New page'} %}
                                <li><form class="nav-form" method="post" action="/admin/articles">
                                    <input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">
                                    <input type="hidden" name="kind" value="{{ kind }}">
                                    <button class="nav-link" type="submit">{{ label }}</button>
                                </form></li>
                            {% endfor %}
                        {% endif %}
                        <li>{% if signed_in|default(false) %}<a href="/account">Your account</a>{% else %}<a href="/login">Sign in</a>{% endif %}</li>
                    </ul>
                </nav>
                <form class="site-search" role="search" method="get" action="/search">
                    <label class="visually-hidden" for="site-search">Search</label>
                    <input id="site-search" type="search" name="q" value="{{ query|default('') }}" placeholder="Search" maxlength="200">
                    <button type="submit">Search</button>
                </form>
            </div>
        </div>
    </header>
    <div class="site-content" id="content">
        {% block main %}{% endblock %}
    </div>
    <footer class="site-footer">
        <nav aria-label="Footer">
            <ul>
                {% for link in site.footer %}<li><a href="{{ link.url }}">{{ link.label }}</a></li>{% endfor %}
                {% if site.imprint %}<li><a href="/{{ site.imprint }}">Impressum</a></li>{% endif %}
                {% if site.privacy %}<li><a href="/{{ site.privacy }}">Datenschutz</a></li>{% endif %}
            </ul>
        </nav>
        <p class="site-colophon"><a href="/feed.atom">Feed</a> · {{ site.title }} · published with <a href="https://github.com/Thiesi/Edict" rel="noopener">Edict</a></p>
    </footer>
{% endblock %}
