{% extends 'base.html.twig' %}

{% set noun = kind == 'page' ? 'page' : 'article' %}
{% set heading = trash ? 'Trash' : (kind == 'page' ? 'Pages' : 'Articles') %}

{% block title %}{{ heading }} · Edict{% endblock %}

{% block body %}
    <main>
        <h1>{{ heading }}</h1>
        <p>
            <a href="/admin">Back to admin</a>
            · <a href="/admin/articles">Articles</a>
            · <a href="/admin/articles?kind=page">Pages</a>
            · <a href="/admin/articles?trash=1&amp;kind={{ kind }}">Trash</a>
        </p>
        {% if not trash %}
            <form method="post" action="/admin/articles">
                <input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">
                <input type="hidden" name="kind" value="{{ kind }}">
                <button type="submit">New {{ noun }}</button>
            </form>
        {% else %}
            <p>Deleted permanently after {{ trash_days }} days in the trash.</p>
        {% endif %}

        {% if articles %}
            <table>
                <thead><tr><th>Title</th><th>Status</th><th>Language</th><th>Address</th>{% if likes %}<th>Likes</th>{% endif %}{% if trash %}<th>Actions</th>{% endif %}</tr></thead>
                <tbody>
                    {% for article in articles %}
                        <tr>
                            <td>{% if trash %}{{ article.workingTitle }}{% else %}<a href="/admin/articles/{{ article.id }}">{{ article.workingTitle }}</a>{% endif %}</td>
                            <td>{{ article.status }}{% if article.hasPendingChanges %}, changes pending{% endif %}</td>
                            <td>{{ article.lang|upper }}</td>
                            <td>/{{ article.slug }}</td>
                            {% if likes %}
                                {% set count = likes[article.id] ?? {real: 0, adjustment: 0, shown: 0} %}
                                <td>{{ count.shown }}{% if count.adjustment != 0 %} <small>({{ count.real }} real, {{ count.adjustment > 0 ? '+' : '' }}{{ count.adjustment }})</small>{% endif %}</td>
                            {% endif %}
                            {% if trash %}
                                <td>
                                    <form method="post" action="/admin/articles/{{ article.id }}/restore">
                                        <input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">
                                        <button type="submit">Restore</button>
                                    </form>
                                    <form method="post" action="/admin/articles/{{ article.id }}/delete">
                                        <input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">
                                        <label><input type="checkbox" name="confirm" value="yes" required> Delete permanently</label>
                                        <button type="submit">Delete</button>
                                    </form>
                                </td>
                            {% endif %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% else %}
            <p>{{ trash ? 'The trash is empty.' : 'Nothing here yet.' }}</p>
        {% endif %}
    </main>
{% endblock %}
