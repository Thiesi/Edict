{% extends 'admin/layout.html.twig' %}

{% set noun = kind == 'page' ? 'page' : 'article' %}
{% set heading = trash ? 'Trash' : (kind == 'page' ? 'Pages' : 'Articles') %}
{% set section = kind == 'page' ? 'pages' : 'articles' %}

{% block title %}{{ heading }} · Edict{% endblock %}

{% block main %}
    <header class="page-head">
        <h1>{{ heading }}</h1>
        {% if not trash %}
            <form method="post" action="/admin/articles">
                <input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">
                <input type="hidden" name="kind" value="{{ kind }}">
                <button class="button-primary" type="submit">New {{ noun }}</button>
            </form>
        {% endif %}
    </header>
    <nav class="tabs" aria-label="{{ kind == 'page' ? 'Pages' : 'Articles' }}">
        <a href="/admin/articles{{ kind == 'page' ? '?kind=page' : '' }}"{% if not trash %} aria-current="page"{% endif %}>{{ kind == 'page' ? 'Pages' : 'Articles' }}</a>
        <a href="/admin/articles?trash=1&amp;kind={{ kind }}"{% if trash %} aria-current="page"{% endif %}>Trash</a>
    </nav>
    {% if trash %}<p class="page-lede">Deleted permanently after {{ trash_days }} days in the trash.</p>{% endif %}
    {% if done == 'unscheduled' %}<p class="notice notice-ok" role="status">Schedule cancelled. It is a draft again; schedule or publish it from the editor.</p>{% endif %}
    {% if done == 'unpublished' %}<p class="notice notice-ok" role="status">Unpublished. Readers no longer see it; publish it again from the editor.</p>{% endif %}
    {% if done == 'trashed' %}<p class="notice notice-ok" role="status">Moved to the trash. You can restore it from the Trash tab for {{ trash_days }} days.</p>{% endif %}

    {% if articles %}
        <table class="list" role="table">
            <thead><tr role="row"><th role="columnheader">Title</th><th role="columnheader">Status</th><th role="columnheader">Language</th>{% if likes %}<th role="columnheader" class="num">Likes</th>{% endif %}<th role="columnheader" class="num">Views</th><th role="columnheader">Actions</th></tr></thead>
            <tbody>
                {% for article in articles %}
                    <tr role="row">
                        <td role="cell" class="cell-title">
                            {% if trash %}{{ article.workingTitle }}{% else %}<a href="/admin/articles/{{ article.id }}">{{ article.workingTitle }}</a>{% endif %}
                            <span class="address">/{{ article.slug }}</span>
                        </td>
                        <td role="cell">{% if article.scheduled %}<span class="pill pill-scheduled">scheduled</span> <time class="when" datetime="{{ article.publishedAt|article_iso }}">{{ article.publishedAt|admin_datetime }}</time>{% else %}<span class="pill pill-{{ article.status }}">{{ article.status }}</span>{% endif %}{% if article.hasPendingChanges %}<span class="visually-hidden">, </span> <span class="pill pill-pending">changes pending</span>{% endif %}</td>
                        <td role="cell"><span class="lang-mark">{{ article.lang|upper }}</span></td>
                        {% if likes %}
                            {% set count = likes[article.id] ?? {real: 0, adjustment: 0, shown: 0} %}
                            <td role="cell" class="num">{{ count.shown }}{% if count.adjustment != 0 %} <small>({{ count.real }} real, {{ count.adjustment > 0 ? '+' : '' }}{{ count.adjustment }})</small>{% endif %}<span class="cell-unit"> {{ count.shown == 1 ? 'like' : 'likes' }}</span></td>
                        {% endif %}
                        {% set seen = views[article.id] ?? {total: 0, recent: 0} %}
                        <td role="cell" class="num">{{ seen.total|number_format }}<span class="cell-unit"> {{ seen.total == 1 ? 'view' : 'views' }}</span><span class="visually-hidden">, </span> <small class="views-recent">{{ seen.recent|number_format }} in {{ recent_days }} days</small></td>
                        {% if trash %}
                            <td role="cell" class="cell-wide">
                                <form method="post" action="/admin/articles/{{ article.id }}/restore">
                                    <input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">
                                    <button class="button-small" type="submit">Restore</button>
                                </form>
                                <form method="post" action="/admin/articles/{{ article.id }}/delete">
                                    <input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">
                                    <label class="check"><input type="checkbox" name="confirm" value="yes" required> Delete permanently</label>
                                    <button class="button-small button-danger" type="submit">Delete</button>
                                </form>
                            </td>
                        {% else %}
                            <td role="cell" class="cell-wide cell-actions">
                                {% if article.isPublished %}
                                    <form method="post" action="/admin/articles/{{ article.id }}/unpublish">
                                        <input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">
                                        <input type="hidden" name="back" value="list">
                                        <button class="button-small" type="submit">{{ article.scheduled ? 'Cancel schedule' : 'Unpublish' }}<span class="visually-hidden"> {{ article.workingTitle }}</span></button>
                                    </form>
                                {% endif %}
                                <form method="post" action="/admin/articles/{{ article.id }}/trash">
                                    <input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">
                                    <button class="button-small button-danger" type="submit">Move to trash<span class="visually-hidden"> {{ article.workingTitle }}</span></button>
                                </form>
                            </td>
                        {% endif %}
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    {% else %}
        <p class="empty">{{ trash ? 'The trash is empty.' : 'Nothing here yet.' }}</p>
    {% endif %}
{% endblock %}
