{% extends 'base.html.twig' %}

{% block title %}{{ trash ? 'Trash' : 'Articles' }} · Edict{% endblock %}

{% block body %}
    <main>
        <h1>{{ trash ? 'Trash' : 'Articles' }}</h1>
        <p>
            <a href="/admin">Back to admin</a>
            {% if trash %}
                · <a href="/admin/articles">Articles</a>
            {% else %}
                · <a href="/admin/articles/new">New article</a>
                · <a href="/admin/articles?trash=1">Trash</a>
            {% endif %}
        </p>
        {% if trash %}<p>Articles are deleted permanently after {{ trash_days }} days in the trash.</p>{% endif %}

        {% if articles %}
            <table>
                <thead><tr><th>Title</th><th>Status</th><th>Language</th><th>Address</th>{% if trash %}<th>Actions</th>{% endif %}</tr></thead>
                <tbody>
                    {% for article in articles %}
                        <tr>
                            <td>{% if trash %}{{ article.title }}{% else %}<a href="/admin/articles/{{ article.id }}">{{ article.title }}</a>{% endif %}</td>
                            <td>{{ article.status }}</td>
                            <td>{{ article.lang|upper }}</td>
                            <td>/{{ article.slug }}</td>
                            {% if trash %}
                                <td>
                                    <form method="post" action="/admin/articles/{{ article.id }}/restore">
                                        <input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">
                                        <button type="submit">Restore</button>
                                    </form>
                                    <form method="post" action="/admin/articles/{{ article.id }}/delete">
                                        <input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">
                                        <label><input type="checkbox" name="confirm" value="yes" required> Delete permanently</label>
                                        <button type="submit">Delete</button>
                                    </form>
                                </td>
                            {% endif %}
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% else %}
            <p>{{ trash ? 'The trash is empty.' : 'No articles yet.' }}</p>
        {% endif %}
    </main>
{% endblock %}
