{% extends 'admin/layout.html.twig' %}

{% set section = 'passkeys' %}

{% block title %}Passkeys · Edict{% endblock %}

{% block main %}
    <header class="page-head">
        <h1>Passkeys</h1>
    </header>
    {% if notice %}<p class="notice" role="status">{{ notice }}</p>{% endif %}

    {% if passkeys %}
        <ul class="key-list">
            {% for passkey in passkeys %}
                <li class="panel">
                    <p class="key-line">{{ passkey.name }}, added {{ passkey.created_at }}{% if passkey.last_used_at %}, last used {{ passkey.last_used_at }}{% endif %}</p>
                    <div class="actions">
                        <form class="key-rename" method="post" action="/admin/passkeys/{{ passkey.id }}/rename">
                            <input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">
                            <label>New name for {{ passkey.name }} <input name="name" value="{{ passkey.name }}" maxlength="64" required></label>
                            <button class="button-small" type="submit">Rename</button>
                        </form>
                        <form method="post" action="/admin/passkeys/{{ passkey.id }}/remove">
                            <input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">
                            <button class="button-small button-danger" type="submit">Remove</button>
                        </form>
                    </div>
                </li>
            {% endfor %}
        </ul>
    {% else %}
        <p class="empty">No passkeys yet.</p>
    {% endif %}

    <section class="panel" aria-labelledby="add-heading">
        <h2 id="add-heading">Add a passkey</h2>
        <p>Adding a way to sign in needs your password and authenticator code. A passkey works only on this site's address.</p>
        <p id="passkey-status" role="status"></p>
        <form id="passkey-add" method="post" action="/admin/passkeys" data-csrf="{{ csrf_token }}">
            <p class="field"><label>Name <input name="name" maxlength="64" placeholder="e.g. Laptop" required></label></p>
            <p class="field"><label>Password <input name="password" type="password" autocomplete="current-password" required></label></p>
            <p class="field"><label>Authenticator code <input name="code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" required></label></p>
            <p class="actions"><button class="button-primary" type="submit">Add passkey</button></p>
        </form>
    </section>
    <script src="/assets/admin/passkey.js" defer></script>
{% endblock %}
