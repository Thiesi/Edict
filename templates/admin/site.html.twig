{% extends 'admin/layout.html.twig' %}

{% set section = 'site' %}

{% block title %}Site · Edict{% endblock %}

{% block main %}
    <header class="page-head">
        <h1>Site</h1>
    </header>
    <p class="page-lede">The name, menu and footer of the public site. Its look is under <a href="/admin/themes">Themes</a>.</p>
    {% if saved %}<p class="notice" role="status">Saved.</p>{% endif %}
    {% if errors %}<p class="notice notice-error" role="alert">Please check the marked fields. Nothing was saved.</p>{% endif %}
    <form class="settings" method="post" action="/admin/site">
        <input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">
        <section class="panel" aria-labelledby="name-heading">
            <h2 id="name-heading">Name</h2>
            <p class="field">
                <label for="title">Site name</label>
                <input id="title" name="title" value="{{ values.title|default('') }}" maxlength="100" required{% if errors.title is defined %} aria-invalid="true" aria-describedby="title-error"{% endif %}>
                {% if errors.title is defined %}<small class="field-error" id="title-error">{{ errors.title }}</small>{% endif %}
            </p>
            <p class="field">
                <label for="description">Description, under the name</label>
                <input id="description" name="description" value="{{ values.description|default('') }}" maxlength="300" size="60"{% if errors.description is defined %} aria-invalid="true" aria-describedby="description-error"{% endif %}>
                {% if errors.description is defined %}<small class="field-error" id="description-error">{{ errors.description }}</small>{% endif %}
            </p>
        </section>
        <section class="panel" aria-labelledby="links-heading">
            <h2 id="links-heading">Menu and footer</h2>
            <p class="field">
                <label for="menu">Menu links</label>
                <textarea id="menu" name="menu" rows="5" cols="60" aria-describedby="menu-help{% if errors.menu is defined %} menu-error{% endif %}"{% if errors.menu is defined %} aria-invalid="true"{% endif %}>{{ values.menu|default('') }}</textarea>
                <small id="menu-help">One per line, as <code>Label | address</code>, for example <code>About | /about</code>. Up to {{ max_links }}. Archive and sign-in come after them.</small>
                {% if errors.menu is defined %}<small class="field-error" id="menu-error">{{ errors.menu }}</small>{% endif %}
            </p>
            <p class="field">
                <label for="footer">Footer links</label>
                <textarea id="footer" name="footer" rows="4" cols="60" aria-describedby="footer-help{% if errors.footer is defined %} footer-error{% endif %}"{% if errors.footer is defined %} aria-invalid="true"{% endif %}>{{ values.footer|default('') }}</textarea>
                <small id="footer-help">The same way. Impressum and Datenschutz come after them.</small>
                {% if errors.footer is defined %}<small class="field-error" id="footer-error">{{ errors.footer }}</small>{% endif %}
            </p>
        </section>
        <section class="panel" aria-labelledby="legal-heading">
            <h2 id="legal-heading">Legal pages</h2>
            {% for name, label in {imprint: 'Impressum page', privacy: 'Datenschutz page'} %}
                <p class="field">
                    <label for="{{ name }}">{{ label }}</label>
                    <select id="{{ name }}" name="{{ name }}"{% if errors[name] is defined %} aria-invalid="true"{% endif %}>
                        <option value="">None yet</option>
                        {% for page in pages %}
                            <option value="{{ page.slug }}"{% if values[name]|default('') == page.slug %} selected{% endif %}>{{ page.title }} (/{{ page.slug }})</option>
                        {% endfor %}
                    </select>
                    {% if errors[name] is defined %}<small class="field-error">{{ errors[name] }}</small>{% endif %}
                </p>
            {% endfor %}
            {% if not pages %}<p><small>Write and publish the Impressum and Datenschutz as <a href="/admin/articles?kind=page">pages</a>, then choose them here. A German site can't go live without them.</small></p>{% endif %}
        </section>
        <p class="actions"><button class="button-primary" type="submit">Save</button></p>
    </form>

    <section class="panel panel-aside" aria-labelledby="templates-heading">
        <h2 id="templates-heading">Start the legal pages from a template</h2>
        <p>Each creates a page draft in German, written for how Edict works: no trackers, no fonts from elsewhere, sign-in through Google or Twitch with only an ID and a name, comments and likes. Fill in everything in [brackets] and check it before publishing. It's a starting point, not legal advice.</p>
        <div class="actions">
            {% for which, label in {imprint: 'Impressum draft', privacy: 'Datenschutz draft'} %}
                <form method="post" action="/admin/site/legal/{{ which }}">
                    <input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">
                    <button type="submit">Create the {{ label }}</button>
                </form>
            {% endfor %}
        </div>
    </section>
{% endblock %}
