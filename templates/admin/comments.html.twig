{% extends 'admin/layout.html.twig' %}

{% set section = 'comments' %}

{% macro action(id, action, label, csrf_field, csrf_token, class = '') %}
    <form method="post" action="/admin/comments/{{ id }}/{{ action }}" class="inline">
        <input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">
        <input type="hidden" name="back" value="queue">
        <button class="button-small{{ class ? ' ' ~ class : '' }}" type="submit">{{ label }}</button>
    </form>
{% endmacro %}

{% block title %}Comments · Edict{% endblock %}

{% block main %}
    {% import _self as self %}
    <header class="page-head">
        <h1>Comments</h1>
    </header>

    <section class="panel" aria-labelledby="held-heading">
        <h2 id="held-heading">Waiting for approval ({{ held|length }})</h2>
        {% if held %}
            <ul class="queue">
                {% for comment in held %}
                    <li>
                        <p class="queue-meta"><strong>{{ comment.author }}</strong> on <a href="/{{ comment.slug }}#comment-{{ comment.id }}">{{ comment.title }}</a>, {{ comment.createdAt|date('Y-m-d H:i') }}</p>
                        <blockquote>{{ comment.body|comment_html }}</blockquote>
                        <div class="actions">
                            {{ self.action(comment.id, 'approve', 'Approve', csrf_field, csrf_token, 'button-primary') }}
                            {{ self.action(comment.id, 'delete', 'Remove', csrf_field, csrf_token, 'button-danger') }}
                            {% if comment.authorId and not comment.trusted %}{{ self.action(comment.id, 'trust', 'Approve author', csrf_field, csrf_token) }}{% endif %}
                            {% if comment.authorId %}{{ self.action(comment.id, 'ban', 'Ban author for 7 days', csrf_field, csrf_token) }}{% endif %}
                        </div>
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p class="page-lede">Nothing is waiting.</p>
        {% endif %}
    </section>

    <section class="panel" aria-labelledby="recent-heading">
        <h2 id="recent-heading">Latest comments</h2>
        {% if recent %}
            <ul class="queue">
                {% for comment in recent %}
                    <li>
                        <p class="queue-meta"><strong>{{ comment.author }}</strong> on <a href="/{{ comment.slug }}#comment-{{ comment.id }}">{{ comment.title }}</a>, {{ comment.createdAt|date('Y-m-d H:i') }}</p>
                        <blockquote>{{ comment.body|comment_html }}</blockquote>
                        <div class="actions">
                            {{ self.action(comment.id, 'delete', 'Remove', csrf_field, csrf_token, 'button-danger') }}
                        </div>
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p class="page-lede">No comments yet.</p>
        {% endif %}
    </section>

    <section class="panel" aria-labelledby="banned-heading">
        <h2 id="banned-heading">Banned accounts</h2>
        {% if banned %}
            <ul class="plain-list">
                {% for user in banned %}
                    <li>
                        <span>{{ user.name }}, {{ user.until > 253000000000 ? 'for good' : 'until ' ~ user.until|date('Y-m-d H:i') }}</span>
                        <form method="post" action="/admin/users/{{ user.id }}/unban" class="inline">
                            <input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">
                            <button class="button-small" type="submit">Lift the ban</button>
                        </form>
                    </li>
                {% endfor %}
            </ul>
        {% else %}
            <p class="page-lede">Nobody is banned.</p>
        {% endif %}
    </section>

    <section class="panel" aria-labelledby="rules-heading">
        <h2 id="rules-heading">Rules</h2>
        {% if saved %}<p class="notice" role="status">Saved.</p>{% endif %}
        {% if errors %}<p class="notice notice-error" role="alert">Please check the marked fields. Nothing was saved.</p>{% endif %}
        <form method="post" action="/admin/comments/rules">
            <input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">
            <fieldset>
                <legend>New comments, unless an article says otherwise</legend>
                <label><input type="radio" name="comment_default" value="open"{% if rules.comment_default|default('open') != 'hold' %} checked{% endif %}> appear immediately</label><br>
                <label><input type="radio" name="comment_default" value="hold"{% if rules.comment_default|default('') == 'hold' %} checked{% endif %}> wait for approval (approved authors skip this)</label>
            </fieldset>
            <p class="field">
                <label for="auto-close">Close comments this many days after publishing (0 for never)</label>
                <input id="auto-close" name="comment_auto_close_days" inputmode="numeric" value="{{ rules.comment_auto_close_days|default('0') }}" size="5"{% if errors.comment_auto_close_days is defined %} aria-invalid="true"{% endif %}>
                {% if errors.comment_auto_close_days is defined %}<small class="field-error">{{ errors.comment_auto_close_days }}</small>{% endif %}
            </p>
            <p class="field">
                <label for="words">Word filter: one word or phrase per line</label>
                <textarea id="words" name="comment_words" rows="6" cols="40"{% if errors.comment_words is defined %} aria-invalid="true"{% endif %}>{{ rules.comment_words|default('') }}</textarea>
                {% if errors.comment_words is defined %}<small class="field-error">{{ errors.comment_words }}</small>{% endif %}
            </p>
            <fieldset>
                <legend>A comment with one of them</legend>
                <label><input type="radio" name="comment_word_action" value="hold"{% if rules.comment_word_action|default('hold') != 'reject' %} checked{% endif %}> waits for approval</label><br>
                <label><input type="radio" name="comment_word_action" value="reject"{% if rules.comment_word_action|default('') == 'reject' %} checked{% endif %}> is refused</label>
            </fieldset>
            <fieldset>
                <legend>Alerts</legend>
                <label><input type="checkbox" name="comment_alerts" value="1"{% if rules.comment_alerts|default('') == '1' %} checked{% endif %}> Email me about each new comment, and each one waiting for approval</label>
                <br><small>{% if alert_to %}They go to {{ alert_to }}.{% else %}Nothing can be sent yet: set your address on <a href="/account">your account</a>, and the server needs <code>MAIL_FROM</code>.{% endif %}</small>
            </fieldset>
            <p class="actions"><button class="button-primary" type="submit">Save rules</button></p>
        </form>
    </section>
{% endblock %}
