{% extends 'base.html.twig' %}

{% block title %}{{ article.workingTitle }} · Edict{% endblock %}

{% block head %}<link rel="stylesheet" href="/assets/build/editor.css?v={{ asset_version }}">{% endblock %}

{% block body %}
    <div id="editor-app" class="editor-app" data-state="{{ state|json_encode }}">
        <header class="editor-bar">
            <a class="button button-quiet editor-back" href="/admin/articles?kind={{ article.kind }}">Back</a>
            <span id="save-status" role="status" data-state="saved">Up to date</span>
            <span id="word-count" class="editor-count" aria-live="off"></span>
            <span class="editor-bar-end">
                <a class="button button-quiet" id="preview" href="/admin/articles/{{ article.id }}/preview" target="_blank" rel="noopener">Preview</a>
                {% if article.isLive and not article.deletedAt %}<a class="button button-quiet" href="/{{ article.slug }}" target="_blank" rel="noopener">View</a>{% endif %}
                <a class="button button-quiet" href="#details-start">Details</a>
                <button type="button" id="media-toggle" aria-expanded="false" aria-controls="media-panel">Media</button>
                {% if not article.deletedAt %}
                    {% if article.canBeScheduled and not article.scheduled %}
                        <button class="button-quiet" type="button" id="schedule-toggle" aria-expanded="false" aria-controls="schedule-panel">Schedule…</button>
                    {% endif %}
                    {# The label follows the time field: "Schedule" while a time is set. #}
                    <button class="button-primary" type="button" id="publish" data-now-label="{{ article.isLive ? 'Update' : 'Publish' }}">{{ publish_at ? 'Schedule' : (article.isLive ? 'Update' : 'Publish') }}</button>
                {% endif %}
            </span>
        </header>

        {% if article.scheduled and not article.deletedAt %}
            <div class="editor-banner editor-scheduled" id="scheduled-banner">
                <p>
                    Scheduled for <strong><time datetime="{{ article.publishedAt|article_iso }}">{{ article.publishedAt|admin_datetime }}</time></strong> (Berlin time). It goes live by itself then.
                    {% if article.hasPendingChanges %}Your changes since then go live only once you schedule or publish again.{% endif %}
                </p>
                <button type="button" id="schedule-change" aria-expanded="false" aria-controls="schedule-panel">Change time</button>
                <button type="button" id="publish-now">Publish now</button>
                <form method="post" action="/admin/articles/{{ article.id }}/unpublish">
                    <input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">
                    <button type="submit">Cancel schedule</button>
                </form>
            </div>
        {% endif %}
        {% if article.canBeScheduled %}
            <div id="schedule-panel" class="editor-schedule" hidden>
                <label for="publish-at">Publish at</label>
                <input type="datetime-local" id="publish-at" value="{{ publish_at }}" min="{{ publish_at_min }}" step="60" aria-describedby="publish-at-help">
                <button type="button" id="publish-at-clear">Clear</button>
                <small id="publish-at-help">Berlin time. Readers see it from then on; until then it stays hidden everywhere.</small>
            </div>
        {% endif %}

        <div id="restore-banner" class="editor-banner" role="alert" hidden>
            <span id="restore-message"></span>
            <button type="button" id="restore-yes">Restore it</button>
            <button type="button" id="restore-no">Discard it</button>
            <details><summary>Show that text</summary><pre id="restore-text"></pre></details>
        </div>
        <p id="editor-errors" class="editor-banner" role="alert" hidden></p>
        {% if restored %}<p class="editor-banner" role="status">The version is in the draft now. Check it, then publish to make it live.</p>{% endif %}
        {% if article.deletedAt %}<p class="editor-banner">This is in the trash. Restore it from the list to publish it.</p>{% endif %}

        <aside id="media-panel" class="media-panel" aria-label="Media library" hidden>
            <p>
                <button type="button" id="media-upload">Upload…</button>
                <button type="button" id="media-insert" disabled>Insert</button>
            </p>
            <div id="media-grid" class="media-grid"></div>
            <p><button type="button" id="media-more" hidden>Show more</button></p>
            {# The same tab: unsaved text keeps the browser asking before it leaves (main.js). #}
            <p class="media-manage"><a href="/admin/media-library">Manage media</a></p>
        </aside>
        <input type="file" id="file-input" multiple hidden aria-label="Choose files">
        <ul id="upload-tray" class="upload-tray" aria-label="Uploads" hidden></ul>

        <main class="editor-page" lang="{{ input.lang in ['de', 'en'] ? input.lang : 'en' }}">
            <label class="editor-label" for="title">Title</label>
            <input id="title" class="editor-title" value="{{ input.title }}" placeholder="Title" autocomplete="off">
            <label class="editor-label" for="teaser">Teaser</label>
            <textarea id="teaser" class="editor-teaser" rows="2" placeholder="Teaser (optional)">{{ input.teaser }}</textarea>
            <div class="editor-cover">
                <input type="hidden" id="cover" value="{{ input.cover }}">
                <img id="cover-preview" alt="Cover image" hidden>
                <p id="cover-missing" class="media-missing" role="status" hidden>The cover image was deleted from the media library. Readers see no cover. Choose another, or remove it.</p>
                <button type="button" id="cover-choose">Choose a cover image…</button>
                <button type="button" id="cover-remove" hidden>Remove the cover</button>
                <label id="cover-alt-field" hidden>Cover description (for screen readers)
                    <input id="cover-alt" value="{{ input.coverAlt }}" maxlength="500" autocomplete="off">
                </label>
            </div>

            <div id="bubble-menu" class="bubble-menu" role="toolbar" aria-label="Text formatting">
                <button type="button" data-command="bold"><strong>B</strong></button>
                <button type="button" data-command="italic"><em>I</em></button>
                <button type="button" data-command="strike"><s>S</s></button>
                <button type="button" data-command="code">Code</button>
                <button type="button" data-command="link">Link</button>
                <button type="button" data-command="h2">H2</button>
                <button type="button" data-command="h3">H3</button>
                <button type="button" data-command="quote">Quote</button>
            </div>
            <div id="table-tools" class="table-tools" role="toolbar" aria-label="Table" hidden>
                <button type="button" data-table="addRowAfter">Add row</button>
                <button type="button" data-table="addColumnAfter">Add column</button>
                <button type="button" data-table="deleteRow">Delete row</button>
                <button type="button" data-table="deleteColumn">Delete column</button>
                <button type="button" data-table="toggleHeaderRow">Header row</button>
                <button type="button" data-table="deleteTable">Delete table</button>
            </div>
            <div id="body" class="editor-body"></div>
        </main>

        <details class="editor-details" id="details">
            <summary>Details</summary>
            <p id="details-start">
                <label for="slug">Address</label>
                <input id="slug" value="{{ input.slug }}" maxlength="120" placeholder="{{ article.publishedAt ? article.slug : 'Derived from the title' }}" aria-describedby="slug-help" autocomplete="off">
                <small id="slug-help">Changing the address of a published article redirects the old one.</small>
            </p>
            <p>
                <label for="lang">Language</label>
                <select id="lang">
                    <option value="de"{% if input.lang == 'de' %} selected{% endif %}>German</option>
                    <option value="en"{% if input.lang == 'en' %} selected{% endif %}>English</option>
                </select>
            </p>
            {% if article.kind == 'article' %}
                <p>
                    <label for="tags">Tags</label>
                    <input id="tags" value="{{ input.tags }}" aria-describedby="tags-help" autocomplete="off" list="tag-suggestions">
                    <datalist id="tag-suggestions"></datalist>
                    <small id="tags-help">Separated by commas. Suggestions come from tags already in use. <a href="/admin/tags">Rename tags</a></small>
                </p>
            {% endif %}
            {% if not article.deletedAt %}
                {# The link is only ever shown when it is made: the database keeps just its hash. #}
                <section class="editor-share" aria-labelledby="share-heading">
                    <h3 id="share-heading">Share preview</h3>
                    <p><small>Anyone with the link can read the current draft without an account, later edits included. It works for {{ preview_link_days }} days, and stops when you publish, schedule or trash this. A new link replaces the old one.</small></p>
                    <div id="share-link" class="editor-share-link" hidden>
                        <label for="share-url">Preview link</label>
                        <span class="editor-share-row">
                            <input id="share-url" readonly aria-describedby="share-once">
                            <button type="button" id="share-copy">Copy</button>
                            <span id="share-copied" class="editor-share-copied" role="status"></span>
                        </span>
                        <small id="share-once">Copy it now: it is shown only this once. Later you can replace it with a new link.</small>
                    </div>
                    <p id="share-status" class="editor-share-status" role="status">
                        {%- if preview_link_expires %}A link is shared until <time datetime="{{ preview_link_expires|article_iso }}">{{ preview_link_expires|admin_datetime }}</time> (Berlin time). To send it again, make a new link.{% endif -%}
                    </p>
                    <p class="editor-share-actions">
                        <button type="button" id="share-create">{{ preview_link_expires ? 'New link' : 'Share preview' }}</button>
                        <button type="button" id="share-stop"{% if not preview_link_expires %} hidden{% endif %}>Stop sharing</button>
                    </p>
                </section>
            {% endif %}
            {% if revisions %}
                <h3>Published versions</h3>
                <p><small>Restoring puts a version into the draft. Readers see it once you publish again.</small></p>
                <ol class="editor-revisions">
                    {% for revision in revisions %}
                        <li>
                            <time datetime="{{ revision.publishedAt|article_iso }}">{{ revision.publishedAt|date('Y-m-d H:i') }}</time>: {{ revision.title }}
                            {% if loop.first %}<small>(what readers {{ article.scheduled ? 'will see' : 'see' }}{% if article.hasPendingChanges %}, before your changes{% endif %})</small>{% endif %}
                            <form method="post" action="/admin/articles/{{ article.id }}/revisions/{{ revision.id }}/restore">
                                <input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">
                                <button class="button-quiet" type="submit">Restore into the draft</button>
                            </form>
                        </li>
                    {% endfor %}
                </ol>
            {% endif %}
            {% if article.publishedAt %}
                <p>Views: <strong>{{ views.total|number_format }}</strong>, {{ views.recent|number_format }} in the last {{ recent_days }} days. <small>Readers only, each once a day; not you, and not bots.</small></p>
            {% endif %}
            <div class="editor-fate">
                <p>
                    Status: <strong>{% if article.scheduled %}scheduled for <time datetime="{{ article.publishedAt|article_iso }}">{{ article.publishedAt|admin_datetime }}</time>{% else %}{{ article.status }}{% endif %}</strong>{% if article.hasPendingChanges %}, with changes readers don't see yet{% endif %}.
                </p>
                {% if not article.deletedAt %}
                    {% if article.isPublished %}
                        <form method="post" action="/admin/articles/{{ article.id }}/unpublish">
                            <input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">
                            <button type="submit">{{ article.scheduled ? 'Cancel schedule' : 'Unpublish' }}</button>
                        </form>
                    {% endif %}
                    <form method="post" action="/admin/articles/{{ article.id }}/trash">
                        <input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">
                        <button class="button-danger" type="submit">Move to trash</button>
                    </form>
                {% endif %}
            </div>
        </details>
        <script type="module" src="/assets/build/editor.js?v={{ asset_version }}"></script>
    </div>
{% endblock %}
