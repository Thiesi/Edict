{% extends 'base.html.twig' %}

{% block title %}Tags · Edict{% endblock %}

{% block body %}
    <main>
        <h1>Tags</h1>
        <p><a href="/admin">Back to admin</a> · <a href="/admin/articles">Articles</a></p>
        {% if renamed %}<p role="status">Renamed everywhere, drafts included.</p>{% endif %}
        {% if error %}<p role="alert">{{ error }}</p>{% endif %}
        <p>Renaming changes the tag on every article and in drafts. Renaming it to a tag that exists merges the two. The tag's address changes with its name.</p>
        {% if tags %}
            <table>
                <thead><tr><th>Tag</th><th>Articles</th><th>Rename to</th></tr></thead>
                <tbody>
                    {% for tag in tags %}
                        <tr>
                            <td><a href="/tag/{{ tag.slug }}">{{ tag.name }}</a></td>
                            <td>{{ tag.count }}</td>
                            <td>
                                <form method="post" action="/admin/tags/{{ tag.slug }}">
                                    <input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">
                                    <label class="visually-hidden" for="rename-{{ tag.slug }}">New name for {{ tag.name }}</label>
                                    <input id="rename-{{ tag.slug }}" name="name" value="{{ tag.name }}" maxlength="64" required>
                                    <button type="submit">Rename</button>
                                </form>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% else %}
            <p>No tags yet. They appear once a published article has some.</p>
        {% endif %}
    </main>
{% endblock %}
