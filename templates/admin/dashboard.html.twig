{% extends 'base.html.twig' %}

{% block title %}Admin · Edict{% endblock %}

{% block body %}
    <main>
        <h1>Admin</h1>
        <p>Signed in as {{ display_name }}.</p>
        <p><a href="/admin/articles">Articles</a> · <a href="/admin/passkeys">Passkeys</a></p>
        <form method="post" action="/admin/logout">
            <input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">
            <button type="submit">Sign out</button>
        </form>
        <form method="post" action="/admin/logout-everywhere">
            <input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">
            <button type="submit">Sign out everywhere</button>
        </form>
    </main>
{% endblock %}
