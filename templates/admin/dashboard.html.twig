{% extends 'base.html.twig' %}

{% block title %}Admin · Edict{% endblock %}

{% block body %}
    <main>
        <h1>Admin</h1>
        <p>Signed in as {{ display_name }}.</p>
        {% if held_comments %}<p role="status"><a href="/admin/comments">{{ held_comments }} {{ held_comments == 1 ? 'comment waits' : 'comments wait' }} for approval</a></p>{% endif %}
        <p><a href="/admin/articles">Articles</a> · <a href="/admin/articles?kind=page">Pages</a> · <a href="/admin/comments">Comments</a> · <a href="/admin/site">Site</a> · <a href="/admin/themes">Themes</a> · <a href="/admin/passkeys">Passkeys</a></p>
        <form method="post" action="/admin/logout">
            <input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">
            <button type="submit">Sign out</button>
        </form>
        <form method="post" action="/admin/logout-everywhere">
            <input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">
            <button type="submit">Sign out everywhere</button>
        </form>
    </main>
{% endblock %}
