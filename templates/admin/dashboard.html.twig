{% extends 'admin/layout.html.twig' %}

{% set section = 'overview' %}

{% block title %}Admin · Edict{% endblock %}

{% block main %}
    <header class="page-head">
        <h1>Overview</h1>
        <form method="post" action="/admin/articles">
            <input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">
            <input type="hidden" name="kind" value="article">
            <button class="button-primary" type="submit">New article</button>
        </form>
    </header>
    <p class="page-lede">Signed in as {{ display_name }}.</p>
    {% if held_comments %}<p class="attention" role="status"><a href="/admin/comments">{{ held_comments }} {{ held_comments == 1 ? 'comment waits' : 'comments wait' }} for approval</a></p>{% endif %}

    <div class="cards">
        <section class="panel" aria-labelledby="drafts-heading">
            <h2 class="card-label" id="drafts-heading">Continue writing</h2>
            {% if drafts %}
                <ul class="plain-list">
                    {% for article in drafts %}
                        <li>
                            <a href="/admin/articles/{{ article.id }}">{{ article.workingTitle }}</a>
                            <span>
                                {% if article.kind == 'page' %}<span class="pill">page</span>{% endif %}
                                {% if article.hasPendingChanges %}<span class="pill pill-pending">changes pending</span>{% else %}<span class="pill">{{ article.status }}</span>{% endif %}
                            </span>
                        </li>
                    {% endfor %}
                </ul>
            {% else %}
                <p class="page-lede">Nothing is unfinished. Every draft is published.</p>
            {% endif %}
        </section>

        {% if scheduled %}
            <section class="panel" aria-labelledby="scheduled-heading">
                <h2 class="card-label" id="scheduled-heading">Scheduled</h2>
                <ul class="plain-list">
                    {% for article in scheduled %}
                        <li>
                            <a href="/admin/articles/{{ article.id }}">{{ article.workingTitle }}</a>
                            <span>
                                {% if article.kind == 'page' %}<span class="pill">page</span>{% endif %}
                                <time class="when" datetime="{{ article.publishedAt|article_iso }}">{{ article.publishedAt|admin_datetime }}</time>
                            </span>
                        </li>
                    {% endfor %}
                </ul>
            </section>
        {% endif %}

        <section class="panel" aria-labelledby="storage-heading">
            <h2 class="card-label" id="storage-heading">Storage</h2>
            {% set gb = 1000000000 %}
            <p class="big-number">{{ (storage.usedBytes / gb)|number_format(1) }} <small>of {{ (storage.maxBytes / gb)|number_format(1) }} GB</small></p>
            <progress class="meter{% if storage.low %} is-low{% endif %}" value="{{ storage.usedBytes }}" max="{{ max(storage.maxBytes, 1) }}" aria-label="Media storage used"></progress>
            <p{% if storage.low %} role="alert"{% endif %}>
                Media: {{ (storage.usedBytes / gb)|number_format(1) }} of {{ (storage.maxBytes / gb)|number_format(1) }} GB,
                {{ storage.files|number_format }} of {{ storage.maxFiles|number_format }} files.
                {% if storage.freeBytes is not null %}Free disk: {{ (storage.freeBytes / gb)|number_format(1) }} GB (uploads stop below {{ (storage.minFreeBytes / gb)|number_format(1) }} GB).{% endif %}
                {% if storage.low %}<strong>Running low.</strong> Ask Ops for room, or <a href="/admin/media-library?show=unused&amp;sort=size">remove media nobody needs</a>.{% endif %}
            </p>
        </section>

        <section class="panel" aria-labelledby="backup-heading">
            <h2 class="card-label" id="backup-heading">Backup</h2>
            <p>Articles, pages, comments and settings as one file.</p>
            <p class="actions"><a class="button" href="/admin/export">Export everything (JSON)</a></p>
        </section>

        <section class="panel" aria-labelledby="sessions-heading">
            <h2 class="card-label" id="sessions-heading">Sessions</h2>
            <p>Lost a device? This signs the admin out on every device, this one included.</p>
            <form class="actions" method="post" action="/admin/logout-everywhere">
                <input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">
                <button class="button-danger" type="submit">Sign out everywhere</button>
            </form>
        </section>
    </div>
{% endblock %}
