{% extends 'base.html.twig' %}

{% block title %}Sign in · Edict{% endblock %}

{% block body %}
    <main>
        <h1>Sign in</h1>
        {% if error %}<p role="alert">{{ error }}</p>{% endif %}
        <form method="post" action="/admin/login">
            {% if csrf_token %}<input type="hidden" name="{{ csrf_field }}" value="{{ csrf_token }}">{% endif %}
            <p><label>Username <input name="username" autocomplete="username" required autofocus></label></p>
            <p><label>Password <input name="password" type="password" autocomplete="current-password" required></label></p>
            <p><label>Authenticator code <input name="code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" required></label></p>
            <p><button type="submit">Sign in</button></p>
        </form>
        <h2>Or use a passkey</h2>
        <p id="passkey-status" role="status"></p>
        <p><button type="button" id="passkey-login" data-csrf="{{ csrf_token }}" hidden>Sign in with a passkey</button></p>
        <script src="/assets/admin/passkey.js" defer></script>
        {% if providers %}
            <h2>Or use an allow-listed account</h2>
            <ul>
                {% for provider in providers %}
                    <li><a href="/auth/{{ provider.name }}?next=%2Fadmin">Continue with {{ provider.label }}</a></li>
                {% endfor %}
            </ul>
        {% endif %}
    </main>
{% endblock %}
