{% extends 'public/layout.html.twig' %}

{% block title %}Sign in · {{ site().title }}{% endblock %}

{% block main %}
    <main class="sign-in">
        <h1>Sign in</h1>
        {% if notice %}<p class="notice notice-error" role="alert">{{ notice }}</p>{% endif %}
        <p>Sign in to comment and to like articles. Edict receives only your provider's account ID and display name, never your email address.</p>
        <ul class="provider-list">
            {% for provider in providers %}
                <li><a class="button button-primary" href="/auth/{{ provider.name }}?next={{ next|url_encode }}">Continue with {{ provider.label }}</a>{% if provider.name == last_provider %} <small>(you used this last time on this device)</small>{% endif %}</li>
            {% else %}
                <li class="empty">Sign-in is not available right now.</li>
            {% endfor %}
        </ul>
    </main>
{% endblock %}
