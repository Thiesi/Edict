# Copy to .env (gitignored) and fill in. Never commit real credentials.
APP_ENV=dev

# Dev DB on Roanoke through the SSH tunnel (bin/tunnel), local port 55432.
DATABASE_URL=pgsql://edict_dev:CHANGE_ME@127.0.0.1:55432/edict_dev
# Used by the "db" test group. Its schema is wiped by tests.
TEST_DATABASE_URL=pgsql://edict_dev:CHANGE_ME@127.0.0.1:55432/edict_test

# SSH target for bin/tunnel, e.g. you@Roanoke.NetWorkXXIII.de
EDICT_TUNNEL_SSH=
