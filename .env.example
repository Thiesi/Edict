# Copy to .env (gitignored) and fill in. Never commit real credentials.
APP_ENV=dev

# Base URL of this instance. Use localhost, not 127.0.0.1: passkeys and OAuth need it.
APP_URL=http://localhost:8080
# Encrypts stored TOTP secrets and keys login throttling. At least 32 characters;
# required outside dev/test. Generate with: php -r "echo bin2hex(random_bytes(32));"
# Changing it invalidates TOTP secrets (run bin/edict admin:reset afterwards).
APP_SECRET=

# Dev DB on Roanoke through the SSH tunnel (bin/tunnel), local port 55432.
DATABASE_URL=pgsql://edict_dev:CHANGE_ME@127.0.0.1:55432/edict_dev
# Used by the "db" test group. Its schema is wiped by tests.
TEST_DATABASE_URL=pgsql://edict_dev:CHANGE_ME@127.0.0.1:55432/edict_test

# SSH target for bin/tunnel, e.g. you@Roanoke.NetWorkXXIII.de
EDICT_TUNNEL_SSH=

# Login providers. A provider without both values is simply not offered.
# Redirect URL to register: <APP_URL, lowercase>/auth/<google|twitch>/callback
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
TWITCH_OIDC_CLIENT_ID=
TWITCH_OIDC_CLIENT_SECRET=

# Media. Without DATA_DIR, uploads fail with a message and nothing else changes.
DATA_DIR=
# MEDIA_MAX_BYTES=10000000000
# MEDIA_MAX_FILES=100000
# Uploads and jobs also stop if the disk would drop below this much free space.
# MEDIA_MIN_FREE_BYTES=5000000000
# VIPSTHUMBNAIL_BIN=vipsthumbnail
# VIPSHEADER_BIN=vipsheader
